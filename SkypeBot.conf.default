# coc-skype-bot run で使う設定ファイルのひな形です。
# SkypeBot.conf という名前でコピーして値を設定してください。各値の調べ方は README を参照してください。
# Skype は 2025-05-05 に提供を終了しているため、現在はこの設定で実際の Skype に接続することはできません。

# Skype classic デスクトップ版のプロフィールのディレクトリ (main.db があるディレクトリ) です。
#     Windows では C:/Users/username/AppData/Roaming/Skype/skypeId
#     Mac では /Users/username/Library/Application Support/Skype/skypeId
dbPath = /Users/username/Library/Application Support/Skype/skypeId

# bot を反応させる会話の id (main.db の Messages テーブルの convo_id) です。空欄の場合は、すべての会話に反応します。
roomId =

# bot を呼び出す接頭辞です。xxx と書くと、「xxx 1d100」のように使います。
key = xxx

# Skype for Web のメッセージ送信先 URL です (https のみ)。
url =

# Skype for Web の RegistrationToken です。
token =
